# ---------- Part 1: leadgen ----------
MAPS_RATE=0.5               # Google Maps requests per second
MAPS_MAX_REQUESTS=600       # hard cap on Maps requests across resumed runs
WEB_RATE=4                  # website requests per second (all sites)
WEB_CONCURRENCY=6           # websites fetched in parallel
# LEADGEN_OUT=output
# LEADGEN_DATA=data

# ---------- Part 2B: WhatsApp bot ----------
# Speech-to-text runs locally with faster-whisper (no API key). The model downloads once on first use.
#   tiny/base = fastest, small = good default (~460 MB), medium = best for Urdu/English mix but slow on CPU
STT_MODEL=small
STT_MODEL_DIR=data/models
STT_DEVICE=cpu              # or cuda with an NVIDIA GPU
STT_COMPUTE_TYPE=int8       # float16 on GPU
STT_LANGUAGE=               # empty = auto-detect; e.g. en or ur to force one

# Numbers the bot may reply to (comma separated, with country code). Also read from ALLOWLIST_FILE.
ALLOWLIST=
ALLOWLIST_FILE=allowlist.txt


MAX_REPLIES_PER_HOUR=30
HUMAN_PACING=1              # reading delay + typing indicator before replies
RECEIPT_GRACE_S=60          # after a crash mid-send: wait this long for a delivery receipt before resending
DISCONNECT_EXIT_S=90        # offline longer than this -> restart with backoff
LEADS_DIRS=benchmark;output
# WA_DATA_DIR=data/wa
